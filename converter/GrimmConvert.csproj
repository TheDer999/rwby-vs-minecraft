<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>GrimmConvert</AssemblyName>
    <RootNamespace>GrimmConvert</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Version>0.3.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AssetsTools.NET" Version="3.0.5" />
    <PackageReference Include="AssetsTools.NET.MonoCecil" Version="3.0.4" />
    <!-- Unity class database used to read built-in types; from the UABEA project (MIT). -->
    <None Include="classdata.tpk" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
